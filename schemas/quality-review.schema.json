{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.doc-automation/schemas/quality-review.schema.json",
  "title": "HWPX output quality evidence",
  "description": "Binds native output and page review evidence to the current artifact bytes. This does not establish business facts or submission approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "native_export", "render", "checks", "visual_review", "status", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "input_dataset_sha256", "template_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"},
        "input_dataset_sha256": {"$ref": "#/$defs/hash"},
        "template_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "native_export": {
      "type": "object", "additionalProperties": false,
      "required": ["application", "version", "build", "source_sha256", "pdf_path", "pdf_sha256", "page_count", "compatibility_notices"],
      "properties": {
        "application": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/hash"},
        "pdf_path": {"$ref": "#/$defs/path"},
        "pdf_sha256": {"$ref": "#/$defs/hash"},
        "page_count": {"type": "integer", "minimum": 1},
        "compatibility_notices": {"type": "array", "items": {"type": "string"}}
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "dpi", "pages"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "dpi": {"type": "integer", "minimum": 72},
        "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["page", "path", "sha256"], "properties": {"page": {"type": "integer", "minimum": 1}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}}}
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "passed", "scope", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "scope": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}}
    },
    "visual_review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "pages"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["page", "status", "observations"], "properties": {"page": {"type": "integer", "minimum": 1}, "status": {"enum": ["pending", "passed", "failed"]}, "observations": {"type": "array", "items": {"type": "string"}}}}}
      }
    },
    "status": {"enum": ["pending", "passed", "failed"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1}
  }
}
